{
	"type": "module",
	"name": "steam-native-notify",
	"version": "0.1.0",
	"description": "Mirror Steam notification toasts to the desktop notification daemon.",
	"main": "./frontend/index.tsx",
	"license": "MIT",
	"scripts": {
		"dev": "millennium-ttc --build dev",
		"build": "node tools/gen-proto.mjs && tsc --noEmit && millennium-ttc --build prod",
		"gen": "node tools/gen-proto.mjs",
		"proto:check": "node tools/proto-sync.mjs --check",
		"proto:update": "node tools/proto-sync.mjs --update",
		"gen:table": "node tools/gen-types-table.mjs",
		"typecheck": "tsc --noEmit",
		"test": "tools/test-backend && node tools/test-routes"
	},
	"dependencies": {
		"@steambrew/client": "^5.5.14",
		"@steambrew/ttc": "^2.7.5"
	},
	"devDependencies": {
		"typescript": "^5.7.2"
	}
}
