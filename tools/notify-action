#!/bin/sh
# Deliver one Steam notification to the desktop, and act on a click.
#
# Spawned detached by backend/main.lua, one per notification. It exists as its
# own process because `notify-send --action` implies `--wait`: it blocks until
# the notification is dismissed or clicked, which would otherwise tie up the
# plugin backend for the notification's lifetime and serialise every
# notification behind the last one.
#
# Usage: notify-action <title> <body> [image] [steam-url]
#        notify-action --resolve-icon <url>     print the resolved icon path

set -u

APP_NAME="Steam"
CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/steam-native-notify/icons"
LIBRARY_CACHE="$HOME/.local/share/Steam/appcache/librarycache"

# The Desktop Notifications spec reserves "default" for the action a plain body
# click invokes. Any other name only fires from a button the daemon may or may
# not draw.
ACTION="default"

# Actions only survive while the popup is live. Omarchy's shell drops an expired
# popup into history as a "restored row" with no live actions, after which a
# click can only dismiss. 0 means it waits for the user instead of expiring.
EXPIRE=0

title=${1:-Steam}
body=${2:-}
image=${3:-}
route=${4:-}

# Turn whatever the toast was showing into something notify-send can display.
# Game art needs no fetch: Steam serves it from a virtual host whose paths map
# one-to-one onto the on-disk library cache. A friend's avatar is on the public
# CDN and has to be pulled once, then cached.
resolve_icon() {
	raw=$1
	[ -n "$raw" ] || { echo steam; return; }

	case $raw in
	/*)
		[ -f "$raw" ] && echo "$raw" || echo steam
		return
		;;
	*steamloopback.host/assets/*)
		tail=${raw#*steamloopback.host/assets/}
		tail=${tail%%\?*}
		[ -f "$LIBRARY_CACHE/$tail" ] && echo "$LIBRARY_CACHE/$tail" || echo steam
		return
		;;
	http://* | https://*) ;;
	*)
		echo steam
		return
		;;
	esac

	stem=${raw%%\?*}
	ext=${stem##*.}
	case $ext in
	jpg | jpeg | png | gif | webp) ext=".$ext" ;;
	*) ext=".img" ;;
	esac

	key=$(printf '%s' "$stem" | sha1sum | cut -d' ' -f1)
	cached="$CACHE/$key$ext"

	if [ -s "$cached" ]; then
		echo "$cached"
		return
	fi

	mkdir -p "$CACHE" 2>/dev/null || { echo steam; return; }
	# Download to a temp name and rename, so an interrupted fetch cannot leave a
	# truncated icon cached forever.
	if curl -fsSL --max-time 5 -o "$cached.part" "$raw" 2>/dev/null && [ -s "$cached.part" ]; then
		mv -f "$cached.part" "$cached"
		echo "$cached"
	else
		rm -f "$cached.part" 2>/dev/null
		echo steam
	fi
}

# Resolution is the fiddliest part and the easiest to get wrong silently, so it
# is exposed for testing: notify-action --resolve-icon <url>
if [ "${1:-}" = "--resolve-icon" ]; then
	resolve_icon "${2:-}"
	exit 0
fi

icon=$(resolve_icon "$image")

# Blocks here. On a click the action name is printed; on dismissal, nothing is.
chosen=$(notify-send -a "$APP_NAME" -i "$icon" -t "$EXPIRE" \
	-A "$ACTION=Open" "$title" "$body" 2>/dev/null)

[ "$chosen" = "$ACTION" ] || exit 0

# No route means Steam itself does nothing for this notification, so neither
# does this. Dismissing is the whole behaviour.
[ -n "$route" ] || exit 0

# Only the route. Raising the Steam window afterwards was tried and removed: it
# is unknown whether Steam's own toast raises the client when its action fires,
# and a route that opens a window (a chat that is not already open) gets focus
# from the window manager anyway. Do not add it back without observing what a
# real actionable Steam toast does first.
steam "$route" >/dev/null 2>&1 &
exit 0
