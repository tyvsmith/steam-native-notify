#!/bin/sh
# Deliver one Steam notification to the desktop, and act on a click.
#
# Spawned detached by backend/main.lua, one per notification. It exists as its
# own process because `notify-send --action` implies `--wait`: it blocks until
# the notification is dismissed or clicked, which would otherwise tie up the
# plugin backend for the notification's lifetime and serialise every
# notification behind the last one.
#
# Usage: notify-action <title> <body> [image] [steam-url] [ingame-action]
#        notify-action --resolve-icon <url>              print the resolved icon path
#        notify-action --click-plan <steam-url> [action] print what a click would run
#        notify-action --escape-markup <text>            print the escaped form
#        notify-action --daemon-caps                     body-markup | plain
#
# <body> arrives raw; markup escaping happens here, immediately before the
# notify-send that renders it. <ingame-action> is a token for types whose
# desktop route is null but whose in-game click does something (see
# frontend/routes.ts clientOverlayAction). The five positional arguments are
# a contract shared with backend/main.lua (which builds the invocation) and
# tools/test-backend (which asserts it).

set -u

APP_NAME="Steam"
RUNTIME_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/steam-native-notify"
CACHE="$RUNTIME_DIR/icons"
LIBRARY_CACHE="$HOME/.local/share/Steam/appcache/librarycache"

# The Desktop Notifications spec reserves "default" for the action a plain body
# click invokes. Any other name only fires from a button the daemon may or may
# not draw.
ACTION="default"

# Actions only survive while the popup is live. Omarchy's shell drops an expired
# popup into history as a "restored row" with no live actions, after which a
# click can only dismiss. 0 means it waits for the user instead of expiring.
EXPIRE=0

title=${1:-Steam}
body=${2:-}
image=${3:-}
route=${4:-}
ingame_action=${5:-}

# A daemon that advertises `body-markup` parses the body as markup, and a
# bare `<` or `&` from a chat message would be swallowed or mangled. Only the
# body is parsed per the spec; the summary is passed through untouched.
escape_markup() {
	printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g'
}

# Whether to escape is the daemon's call, advertised via GetCapabilities:
# quickshell, GNOME, KDE and mako parse markup; dunst is configurable either
# way. Escaping for a plain-text daemon shows literal entities, so ask. If the
# daemon is unreachable (login race; the send below retries), assume markup --
# right for the daemons that dominate, merely cosmetic when wrong.
daemon_parses_markup() {
	caps=$(gdbus call --session --dest org.freedesktop.Notifications \
		--object-path /org/freedesktop/Notifications \
		--method org.freedesktop.Notifications.GetCapabilities 2>/dev/null) || return 0
	case $caps in
	*body-markup*) return 0 ;;
	*) return 1 ;;
	esac
}

# Turn whatever the toast was showing into something notify-send can display.
# Game art needs no fetch: Steam serves it from a virtual host whose paths map
# one-to-one onto the on-disk library cache. A friend's avatar is on the public
# CDN and has to be pulled once, then cached.
resolve_icon() {
	raw=$1
	[ -n "$raw" ] || { echo steam; return; }

	case $raw in
	/*)
		[ -f "$raw" ] && echo "$raw" || echo steam
		return
		;;
	*steamloopback.host/assets/*)
		tail=${raw#*steamloopback.host/assets/}
		tail=${tail%%\?*}
		[ -f "$LIBRARY_CACHE/$tail" ] && echo "$LIBRARY_CACHE/$tail" || echo steam
		return
		;;
	http://* | https://*) ;;
	*)
		echo steam
		return
		;;
	esac

	stem=${raw%%\?*}
	ext=${stem##*.}
	case $ext in
	jpg | jpeg | png | gif | webp) ext=".$ext" ;;
	*) ext=".img" ;;
	esac

	key=$(printf '%s' "$stem" | sha1sum | cut -d' ' -f1)
	cached="$CACHE/$key$ext"

	if [ -s "$cached" ]; then
		echo "$cached"
		return
	fi

	mkdir -p "$CACHE" 2>/dev/null || { echo steam; return; }
	# Download to a temp name and rename, so an interrupted fetch cannot leave a
	# truncated icon cached forever.
	if curl -fsSL --max-time 5 -o "$cached.part" "$raw" 2>/dev/null && [ -s "$cached.part" ]; then
		mv -f "$cached.part" "$cached"
		echo "$cached"
	else
		rm -f "$cached.part" 2>/dev/null
		echo steam
	fi
}

# A click must both surface the client and navigate it. Steam's own nav,
# openurl and settings handlers never raise a window -- Steam's toasts are only
# clickable while Steam is focused, so its code never needed to -- and an
# argless `steam` is the launcher-activation path: the running client shows and
# focuses its main window itself, on any window manager. Sequenced so
# activation lands before the route, and so a client that has to boot first
# boots, then navigates.
#
# Chat routes are the exception: the client's friends/message handler passes
# btakefocus=1 and force-focuses the chat window itself. Raising the main
# window at the same time could bury the dialog the click just opened.
#
# A running game is the other exception. Steam's own in-game toast clicks all
# stay in the overlay, and NO steam:// URL reproduces that: even a bare
# openurl navigates the desktop client and raises it OVER the game (observed
# 2026-08-29, Helldivers 2). The client routes a chat click into the overlay
# by itself, so chat routes still go through `steam`; an openurl route is
# written to a click file the plugin's click bridge picks up and opens in the
# overlay browser through Steam's own activate-overlay ingestion; nav and
# settings routes have no overlay equivalent, so their in-game clicks are
# inert rather than disruptive. Detection is Steam's launch chain: every
# title runs under `reaper SteamLaunch AppId=N`, checked at click time.
game_running() {
	case ${NOTIFY_ACTION_GAME:-auto} in
	yes) return 0 ;;
	no) return 1 ;;
	esac
	pgrep -f 'SteamLaunch AppId=' >/dev/null 2>&1
}

click_plan() {
	# An in-game action token (Screenshot -> media, PlaytimeWarning ->
	# requestplaytime) only means anything while a game is running; on the
	# desktop these types mirror Steam by doing nothing.
	if [ -n "${2:-}" ] && game_running; then
		echo overlay-action
		return
	fi
	case ${1:-} in
	"") echo none ;;
	steam://friends/message/*) echo route ;;
	# Settings routes ride the bridge: the overlay ingestion's "settings"
	# dialog opens Settings, which is where Steam's own in-game clicks land
	# for BOTH SystemUpdate and HardwareUpdate (observed 2026-08-29; the
	# overlay runs the component's gamepad branch, which folds controller
	# into Settings too). nav routes stay inert in-game: Steam's own
	# in-game DownloadCompleted click does nothing (observed).
	steam://openurl/* | steam://settings/*) game_running && echo overlay || echo activate+route ;;
	*) game_running && echo none || echo activate+route ;;
	esac
}

# Resolution is the fiddliest part and the easiest to get wrong silently, so it
# is exposed for testing: notify-action --resolve-icon <url>
if [ "${1:-}" = "--resolve-icon" ]; then
	resolve_icon "${2:-}"
	exit 0
fi

if [ "${1:-}" = "--click-plan" ]; then
	click_plan "${2:-}" "${3:-}"
	exit 0
fi

# Escaping is easy to get wrong silently, so it is exposed for testing like
# the other seams: notify-action --escape-markup <text>
if [ "${1:-}" = "--escape-markup" ]; then
	escape_markup "${2:-}"
	exit 0
fi

if [ "${1:-}" = "--daemon-caps" ]; then
	daemon_parses_markup && echo body-markup || echo plain
	exit 0
fi

icon=$(resolve_icon "$image")
if daemon_parses_markup; then
	body=$(escape_markup "$body")
fi

# Blocks here. On a click the action name is printed; on dismissal, nothing is.
#
# The daemon can be briefly absent -- at login the backend can deliver before
# the session's daemon owns the bus name (observed: a fire 24s after login was
# lost), and a daemon restart drops it too. notify-send fails fast and
# silently then, so retry for ~30s rather than lose the notification; a
# machine with no daemon at all gives up quietly.
tries=0
until chosen=$(notify-send -a "$APP_NAME" -i "$icon" -t "$EXPIRE" \
	-A "$ACTION=Open" "$title" "$body" 2>/dev/null); do
	tries=$((tries + 1))
	[ "$tries" -lt 10 ] || exit 1
	sleep "${NOTIFY_ACTION_RETRY_DELAY:-3}"
done

[ "$chosen" = "$ACTION" ] || exit 0

# Neither a route nor an in-game action means Steam itself does nothing for
# this notification, so neither does this. Dismissing is the whole behaviour.
[ -n "$route" ] || [ -n "$ingame_action" ] || exit 0

case $(click_plan "$route" "$ingame_action") in
route)
	steam "$route" >/dev/null 2>&1 &
	;;
activate+route)
	{
		steam
		steam "$route"
	} >/dev/null 2>&1 &
	;;
overlay)
	printf '%s' "$route" >"$RUNTIME_DIR/.click"
	;;
overlay-action)
	printf 'action:%s' "$ingame_action" >"$RUNTIME_DIR/.click"
	;;
esac
exit 0
