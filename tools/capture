#!/usr/bin/env bash
# Report what the plugin is doing, in the order the answers are needed:
# is the running .star current, did the notification hook attach, and what did
# the last notification carry.
#
# Usage: tools/capture [n]      n = how many notification lines to show (default 8)
#
# Two log sources. Steam's console-linux.txt carries Millennium's loader lines
# (the "Delegating frontend load" stamp that dates the running frontend).
# The plugin's own diagnostics do NOT go there: Millennium buffers a packed
# (.star) plugin's logger output in memory, so backend/main.lua mirrors every
# line into PLUGIN_LOG, truncated at each backend load.

set -uo pipefail

LOG="$HOME/.steam/steam/logs/console-linux.txt"
PLUGIN_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/steam-native-notify/plugin.log"
BUNDLE="$HOME/.local/share/millennium/plugins/me.tysmith.steam-native-notify.star"
LINES="${1:-8}"

# The Steam log is not valid UTF-8 throughout and is full of ANSI colour.
steam_log_lines() { grep -a "me.tysmith.steam-native-notify" "$LOG" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'; }
plugin_lines() { cat "$PLUGIN_LOG" 2>/dev/null; }

hr() { printf '%s\n' "----------------------------------------------------------------"; }

if [[ ! -f $LOG ]]; then
  echo "No Steam log at $LOG — is Steam installed and has it run?" >&2
  exit 1
fi

echo "== 1. is the running plugin the .star on disk? =="
if [[ -f $BUNDLE ]]; then
  built=$(stat -c %Y "$BUNDLE")
  printf '   built   %s\n' "$(date -d "@$built" '+%Y-%m-%d %H:%M:%S')"
else
  echo "   built   (no .star — run: bun run build)"
  built=0
fi

loaded_line=$(steam_log_lines | grep -a "Delegating frontend load" | tail -1)
if [[ -n $loaded_line ]]; then
  loaded_stamp=$(sed -n 's/^\[\([0-9-]* [0-9:]*\)\].*/\1/p' <<<"$loaded_line")
  printf '   loaded  %s\n' "$loaded_stamp"
  loaded=$(date -d "$loaded_stamp" +%s 2>/dev/null || echo 0)
  if (( built > loaded )); then
    echo "   STALE — Steam is running an older build."
    echo "   A frontend change needs a FULL Steam restart (toggling the plugin"
    echo "   reloads only the backend): steam -shutdown, wait, relaunch, re-run this."
  else
    echo "   current."
  fi
else
  echo "   loaded  (never) — enable the plugin in Millennium > Plugins."
fi

hr
echo "== 2. did the hook attach, and did startup data load? =="
# These prefixes are the contract stated in frontend/log.ts; keep in sync.
verdict=$(plugin_lines | grep -aE "hook installed|hook failed|g_PopupManager never appeared|url templates:|identity:|helper" | tail -6)
if [[ -n $verdict ]]; then printf '%s\n' "$verdict"; else echo "   (nothing yet — no $PLUGIN_LOG; has the backend loaded?)"; fi

hr
echo "== 3. what did the last notifications carry? =="
# A `dev-fire:` line with no `from-toast` line after it means Steam's own
# per-type gating swallowed the test fire, not a break (docs/HANDOFF.md).
notifs=$(plugin_lines | grep -aE "from-toast |toast .* -> |dev-fire" | tail -"$LINES")
if [[ -n $notifs ]]; then printf '%s\n' "$notifs"; else echo "   (no notifications captured yet — trigger one)"; fi
