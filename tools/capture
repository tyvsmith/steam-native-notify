#!/usr/bin/env bash
# Report what the plugin is doing, in the order the answers are needed:
# is the running bundle current, did the notification feed attach, and what did
# the last notification carry.
#
# Usage: tools/capture [n]      n = how many notification lines to show (default 8)

set -uo pipefail

LOG="$HOME/.steam/steam/logs/console-linux.txt"
BUNDLE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/.millennium/Dist/index.js"
LINES="${1:-8}"

# The log is not valid UTF-8 throughout and is full of ANSI colour.
plugin_lines() { grep -a "steam-native-notify" "$LOG" 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g'; }

hr() { printf '%s\n' "----------------------------------------------------------------"; }

if [[ ! -f $LOG ]]; then
  echo "No Steam log at $LOG — is Steam installed and has it run?" >&2
  exit 1
fi

echo "== 1. is the running bundle the one on disk? =="
if [[ -f $BUNDLE ]]; then
  built=$(stat -c %Y "$BUNDLE")
  printf '   built   %s\n' "$(date -d "@$built" '+%Y-%m-%d %H:%M:%S')"
else
  echo "   built   (no bundle — run: npm run build)"
  built=0
fi

loaded_line=$(plugin_lines | grep -a "Delegating frontend load" | tail -1)
if [[ -n $loaded_line ]]; then
  loaded_stamp=$(sed -n 's/^\[\([0-9-]* [0-9:]*\)\].*/\1/p' <<<"$loaded_line")
  printf '   loaded  %s\n' "$loaded_stamp"
  loaded=$(date -d "$loaded_stamp" +%s 2>/dev/null || echo 0)
  if (( built > loaded )); then
    echo "   STALE — Steam is running an older build."
    echo "   Toggle the plugin off and on in Millennium > Plugins, then re-run this."
  else
    echo "   current."
  fi
else
  echo "   loaded  (never) — enable the plugin in Millennium > Plugins."
fi

hr
echo "== 2. did the notification feed attach? =="
verdict=$(plugin_lines | grep -aE "Notifications keys=|ClientNotifications keys=|can replay =|notification feed|no notification feed|hook installed" | tail -6)
if [[ -n $verdict ]]; then printf '%s\n' "$verdict"; else echo "   (nothing yet)"; fi

hr
echo "== 3. what did the last notifications carry? =="
notifs=$(plugin_lines | grep -aE "notif index=|toast .* -> " | tail -"$LINES")
if [[ -n $notifs ]]; then printf '%s\n' "$notifs"; else echo "   (no notifications captured yet — trigger one)"; fi
