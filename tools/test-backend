#!/usr/bin/env lua5.4
-- Exercise backend/main.lua without Steam.
--
-- `luac -p` only proves the file parses. Both times this backend broke it was a
-- nil global at runtime -- PLUGIN_DIR removed by an over-eager edit, and before
-- that PLUGIN_DIR declared below the function using it. Either would have been
-- caught here in a second.
--
-- Millennium's modules are stubbed and os.execute is captured, so nothing is
-- spawned and no notification appears.

local root = arg[0]:match("(.*)/tools/[^/]+$") or "."

-- The backend materializes its helper into ${XDG_CACHE_HOME}/steam-native-notify
-- at load. Point that at a throwaway directory so the test never touches the
-- real cache; os.getenv is intercepted before main.lua reads it at load time.
local tmp_handle = io.popen("mktemp -d")
local tmp_cache = tmp_handle:read("*l")
tmp_handle:close()
assert(tmp_cache and tmp_cache ~= "", "mktemp failed")

local real_getenv = os.getenv
os.getenv = function(name)
	if name == "XDG_CACHE_HOME" then return tmp_cache end
	return real_getenv(name)
end

local logged = {}
package.preload["logger"] = function()
	return {
		info = function(_, m) logged[#logged + 1] = { "info", m } end,
		error = function(_, m) logged[#logged + 1] = { "error", m } end,
	}
end
-- Stubbed before the module loads: main.lua captures `millennium` at load time,
-- so a stub installed afterwards would never be seen. assets.read serves the
-- real helper from the repo, standing in for the copy packed into the .star.
local stored = {}
package.preload["millennium"] = function()
	return {
		ready = function() end,
		config = {
			get = function(k) return stored[k] end,
			set = function(k, v) stored[k] = v end,
		},
		assets = {
			read = function(path)
				local handle = io.open(root .. "/" .. path, "r")
				if not handle then return nil end
				local content = handle:read("*a")
				handle:close()
				return content
			end,
		},
	}
end
-- os.execute is captured below, so the stub binds the real one now and
-- creates directories for real.
local mkdir_execute = os.execute
package.preload["fs"] = function()
	return {
		create_directories = function(path)
			return mkdir_execute("mkdir -p '" .. path .. "'") ~= nil
		end,
	}
end

-- Enough JSON for the flat payloads the frontend sends: strings, booleans and
-- numbers. Anything else these messages do not use.
local function decode(text)
	-- The real json module errors on non-JSON; the permissive stub hid that.
	if not text:match("^%s*{") then error("not a JSON object") end
	local out = {}
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*"(.-)"') do
		out[key] = value:gsub('\\"', '"')
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(true)') do
		out[key] = true
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(false)') do
		out[key] = false
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(%-?%d+%.?%d*)') do
		out[key] = tonumber(value)
	end
	return out
end
local function encode(value)
	local parts = {}
	for k, v in pairs(value) do
		local rendered = type(v) == "string" and ('"' .. v .. '"') or tostring(v)
		parts[#parts + 1] = '"' .. k .. '":' .. rendered
	end
	return "{" .. table.concat(parts, ",") .. "}"
end
package.preload["json"] = function()
	return { decode = decode, encode = encode }
end

local executed = {}
local real_execute = os.execute
os.execute = function(command)
	executed[#executed + 1] = command
	return true
end

local plugin = dofile(root .. "/backend/main.lua")

local failures = 0
local function check(what, ok, detail)
	if ok then
		print(("  ok   %s"):format(what))
	else
		failures = failures + 1
		print(("  FAIL %s%s"):format(what, detail and ("\n       " .. detail) or ""))
	end
end

-- on_load must not throw, and must find the helper.
local ok, err = pcall(plugin.on_load)
check("on_load runs", ok, err)

local sawHelper = false
for _, entry in ipairs(logged) do
	if entry[2]:find("helper: ") then sawHelper = true end
	if entry[1] == "error" then check("no errors at load", false, entry[2]) end
end
check("helper installed at load", sawHelper)

-- The materialized helper must be byte-identical to the packed asset (here:
-- the repo copy the assets.read stub serves).
local function slurp(path)
	local handle = io.open(path, "r")
	if not handle then return nil end
	local content = handle:read("*a")
	handle:close()
	return content
end
check("helper materialized verbatim",
	slurp(tmp_cache .. "/steam-native-notify/notify-action") == slurp(root .. "/tools/notify-action"))

-- A notification with no route: the download-complete shape.
executed = {}
ok, err = pcall(Notify, '{"title":"Download Complete","body":"Aircar is ready","image":"https://steamloopback.host/assets/1073390/x.jpg?c=1","route":null}')
check("Notify with no route runs", ok, err)
check("Notify spawned something", #executed == 1, tostring(#executed) .. " commands")
if executed[1] then
	check("spawns the helper through sh", executed[1]:sub(1, 3) == "sh ", executed[1])
	check("spawns the materialized helper", executed[1]:find("steam%-native%-notify/notify%-action") ~= nil, executed[1])
	check("passes the title", executed[1]:find("'Download Complete'", 1, true) ~= nil, executed[1])
	check("passes the image", executed[1]:find("steamloopback", 1, true) ~= nil, executed[1])
	check("backgrounded", executed[1]:sub(-1) == "&", executed[1])
end

-- A notification with a route: the friend-message shape.
executed = {}
ok = pcall(Notify, '{"title":"NightFury","body":"hello","image":"","route":"steam://friends/message/76561198257837083"}')
check("Notify with a route runs", ok)
if executed[1] then
	check("passes the route", executed[1]:find("steam://friends/message/", 1, true) ~= nil, executed[1])
end

-- The body crosses to the helper raw; markup escaping is the helper's job,
-- done next to the notify-send that renders it (asserted further down).
executed = {}
pcall(Notify, '{"title":"Someone","body":"a < b & c","image":"","route":null}')
if executed[1] then
	check("passes the body raw", executed[1]:find("'a < b & c'", 1, true) ~= nil, executed[1])
end

-- A shell metacharacter in the body must not escape its quoting.
executed = {}
pcall(Notify, [[{"title":"Someone","body":"; touch /tmp/pwned #","image":"","route":null}]])
if executed[1] then
	check("quotes shell metacharacters", executed[1]:find("'; touch /tmp/pwned #'", 1, true) ~= nil, executed[1])
end

-- Settings round-trip through Millennium's config store as one JSON document;
-- the backend stores the payload verbatim and never learns a setting name.
ok, err = pcall(SaveSettings, '{"hideSteamToast":true,"someFutureSetting":7}')
check("SaveSettings runs", ok, err)
check("SaveSettings stores the document verbatim",
	stored.settings == '{"hideSteamToast":true,"someFutureSetting":7}', tostring(stored.settings))
local loaded
ok, loaded = pcall(LoadSettings)
check("LoadSettings runs", ok, loaded)
check("LoadSettings returns the document", loaded == stored.settings, tostring(loaded))
ok = pcall(SaveSettings, "not json")
check("SaveSettings survives garbage", ok)
check("garbage is not stored", stored.settings ~= "not json", tostring(stored.settings))

-- Migration: an install that stored hideSteamToast under its own key still
-- loads it until the first save writes the document.
stored.settings = nil
stored.hideSteamToast = true
ok, loaded = pcall(LoadSettings)
check("LoadSettings migrates the old key", ok and type(loaded) == "string" and loaded:find('"hideSteamToast":true', 1, true) ~= nil, tostring(loaded))

-- Identity: shape only. The steamid comes from the machine's loginusers.vdf,
-- which this test does not fabricate; present it must be a steamid64, absent
-- the object is simply empty and the frontend routes without one.
local id_json
ok, id_json = pcall(Identity)
check("Identity runs", ok, id_json)
check("Identity returns JSON", type(id_json) == "string" and id_json:sub(1, 1) == "{", tostring(id_json))
if type(id_json) == "string" and id_json:find("steamid64") then
	check("Identity id is a steamid64", id_json:find('"7656119%d%d%d%d%d%d%d%d%d%d"') ~= nil, id_json)
end

-- TakeDevCommand: consume-once semantics against the runtime cache directory
-- (created by on_load above), the same place tools/fire writes.
local fire = assert(io.open(tmp_cache .. "/steam-native-notify/.dev-fire", "w"))
fire:write('{"call":"TestFriendOnline","args":[]}')
fire:close()
local taken
ok, taken = pcall(TakeDevCommand)
check("TakeDevCommand runs", ok, taken)
check("TakeDevCommand returns the command", type(taken) == "string" and taken:find("TestFriendOnline") ~= nil, tostring(taken))
ok, taken = pcall(TakeDevCommand)
check("TakeDevCommand consumes once", ok and taken == "", tostring(taken))

-- TakeClick: the in-game click handoff, same consume-once contract.
local click = assert(io.open(tmp_cache .. "/steam-native-notify/.click", "w"))
click:write("steam://openurl/https://store.steampowered.com/gifts/")
click:close()
ok, taken = pcall(TakeClick)
check("TakeClick returns the route", ok and taken == "steam://openurl/https://store.steampowered.com/gifts/", tostring(taken))
ok, taken = pcall(TakeClick)
check("TakeClick consumes once", ok and taken == "", tostring(taken))

-- Garbage in must not throw.
executed = {}
ok = pcall(Notify, "not json at all")
check("survives an undecodable payload", ok)

-- notify-action's click plan: chat routes self-focus inside Steam and must not
-- get the activation preamble; everything else must, EXCEPT in the overlay
-- context (Steam rendered its toast in the focused game's overlay), where
-- raising the desktop client would pull the player out of the game. The
-- context is an explicit argument, so the plan never inspects the system.
local function click_plan(route, ctx, action)
	local handle = io.popen(root .. "/tools/notify-action --click-plan '" .. route
		.. "' '" .. (action or "") .. "' '" .. (ctx or "") .. "'")
	local plan = handle:read("*l")
	handle:close()
	return plan
end
check("click plan: chat route skips activation", click_plan("steam://friends/message/76561198000000000") == "route")
check("click plan: nav route activates first", click_plan("steam://nav/games/details/570") == "activate+route")
check("click plan: openurl route activates first", click_plan("steam://openurl/https://steamcommunity.com/x") == "activate+route")
check("click plan: settings route activates first", click_plan("steam://settings/system") == "activate+route")
check("click plan: no route does nothing", click_plan("") == "none")
check("click plan: in-game openurl route goes to the overlay bridge", click_plan("steam://openurl/https://steamcommunity.com/x", "overlay") == "overlay")
check("click plan: in-game system settings goes to the overlay bridge", click_plan("steam://settings/system", "overlay") == "overlay")
check("click plan: in-game controller settings goes to the overlay bridge", click_plan("steam://settings/controller", "overlay") == "overlay")
check("click plan: in-game nav route is inert", click_plan("steam://nav/games/details/570", "overlay") == "none")
check("click plan: in-game chat route rides the bridge", click_plan("steam://friends/message/76561198000000000", "overlay") == "overlay")
check("click plan: in-game action token goes to the action bridge", click_plan("", "overlay", "media") == "overlay-action")
check("click plan: desktop action token stays inert", click_plan("", "no", "media") == "none")

-- notify-action's markup escaping: the daemon parses the body as markup, so
-- what the helper hands notify-send must have &, <, > entity-escaped.
local function escaped_body(text)
	local handle = io.popen(root .. "/tools/notify-action --escape-markup '" .. text .. "'")
	local out = handle:read("*a")
	handle:close()
	return out
end
check("escape: entities", escaped_body("a < b & c") == "a &lt; b &amp; c")
check("escape: ampersand first", escaped_body("&lt;") == "&amp;lt;")
check("escape: clean text untouched", escaped_body("hello there") == "hello there")

-- notify-action's icon resolution, offline paths only: anything that cannot be
-- mapped to an existing file must fall back to the "steam" theme icon.
local function resolved_icon(url)
	local handle = io.popen(root .. "/tools/notify-action --resolve-icon '" .. url .. "'")
	local icon = handle:read("*l")
	handle:close()
	return icon
end
check("resolve-icon: missing library-cache asset falls back",
	resolved_icon("https://steamloopback.host/assets/999999999/missing.jpg?c=1") == "steam")
check("resolve-icon: missing absolute path falls back",
	resolved_icon("/nonexistent/steam-native-notify/icon.png") == "steam")
check("resolve-icon: garbage falls back",
	resolved_icon("not a url at all") == "steam")

-- Delivery retry: at login the helper can run before the session's daemon
-- owns the bus name, and notify-send fails fast. A PATH shim fails twice and
-- succeeds on the third call; the helper must retry through the failures and
-- deliver exactly once.
local shim_handle = io.popen("mktemp -d")
local shim_dir = shim_handle:read("*l")
shim_handle:close()
if shim_dir and shim_dir ~= "" then
	local shim = assert(io.open(shim_dir .. "/notify-send", "w"))
	shim:write(([[#!/bin/sh
n=$(cat %s/count 2>/dev/null || echo 0)
n=$((n + 1))
printf %%s "$n" > %s/count
[ "$n" -ge 3 ] || exit 1
exit 0
]]):format(shim_dir, shim_dir))
	shim:close()
	io.popen("chmod +x '" .. shim_dir .. "/notify-send'"):close()
	io.popen("NOTIFY_ACTION_RETRY_DELAY=0 PATH='" .. shim_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action 'Retry Test' 'body' '' ''; echo done"):read("*a")
	local count_handle = io.open(shim_dir .. "/count", "r")
	local count = count_handle and count_handle:read("*a") or "(no shim calls)"
	if count_handle then count_handle:close() end
	check("delivery retried through daemon absence", count == "3", tostring(count))
	io.popen("rm -rf '" .. shim_dir .. "'"):close()
else
	print("  skip delivery retry (mktemp failed)")
end

-- Markup escaping is conditional on the daemon's advertised capabilities:
-- a plain-text daemon must receive the raw body, a markup daemon the escaped
-- one, and an unreachable daemon defaults to escaped. gdbus and notify-send
-- are PATH-shimmed; the body is notify-send's tenth argument.
local function delivered_body(gdbus_script)
	local h = io.popen("mktemp -d")
	local dir = h:read("*l")
	h:close()
	if not dir or dir == "" then return nil end
	local g = assert(io.open(dir .. "/gdbus", "w"))
	g:write("#!/bin/sh\n" .. gdbus_script .. "\n")
	g:close()
	local ns = assert(io.open(dir .. "/notify-send", "w"))
	ns:write(([[#!/bin/sh
printf '%%s' "${10}" > %s/body
exit 0
]]):format(dir))
	ns:close()
	io.popen("chmod +x '" .. dir .. "/gdbus' '" .. dir .. "/notify-send'"):close()
	io.popen("PATH='" .. dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action 'T' 'a < b & c' '' ''; echo done"):read("*a")
	local b = io.open(dir .. "/body", "r")
	local body = b and b:read("*a") or "(nothing delivered)"
	if b then b:close() end
	io.popen("rm -rf '" .. dir .. "'"):close()
	return body
end
check("caps: markup daemon gets the escaped body",
	delivered_body([[echo "(['actions', 'body', 'body-markup'],)"]]) == "a &lt; b &amp; c")
check("caps: plain-text daemon gets the raw body",
	delivered_body([[echo "(['actions', 'body'],)"]]) == "a < b & c")
check("caps: unreachable daemon defaults to escaped",
	delivered_body([[exit 1]]) == "a &lt; b &amp; c")

os.execute = real_execute
os.getenv = real_getenv
if tmp_cache:find("^/tmp/") then os.execute("rm -rf '" .. tmp_cache .. "'") end

print(failures == 0 and "\nPASS" or ("\n" .. failures .. " FAILED"))
os.exit(failures == 0 and 0 or 1)
