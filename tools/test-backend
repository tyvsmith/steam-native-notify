#!/usr/bin/env lua5.4
-- Exercise backend/main.lua without Steam.
--
-- `luac -p` only proves the file parses. Both times this backend broke it was a
-- nil global at runtime -- PLUGIN_DIR removed by an over-eager edit, and before
-- that PLUGIN_DIR declared below the function using it. Either would have been
-- caught here in a second.
--
-- Millennium's modules are stubbed and os.execute is captured, so nothing is
-- spawned and no notification appears.

local root = arg[0]:match("(.*)/tools/[^/]+$") or "."

-- The backend materializes its helper into ${XDG_CACHE_HOME}/steam-native-notify
-- at load. Point that at a throwaway directory so the test never touches the
-- real cache; os.getenv is intercepted before main.lua reads it at load time.
local tmp_handle = io.popen("mktemp -d")
local tmp_cache = tmp_handle:read("*l")
tmp_handle:close()
assert(tmp_cache and tmp_cache ~= "", "mktemp failed")

local real_getenv = os.getenv
os.getenv = function(name)
	if name == "XDG_CACHE_HOME" then return tmp_cache end
	return real_getenv(name)
end

local logged = {}
package.preload["logger"] = function()
	return {
		info = function(_, m) logged[#logged + 1] = { "info", m } end,
		error = function(_, m) logged[#logged + 1] = { "error", m } end,
	}
end
-- Stubbed before the module loads: main.lua captures `millennium` at load time,
-- so a stub installed afterwards would never be seen. assets.read serves the
-- real helper from the repo, standing in for the copy packed into the .star.
local stored = {}
-- steam_path answers with a throwaway Steam directory; a test that needs a
-- loginusers.vdf writes one there. Empty by default, so Identity falls
-- through to the machine's real candidates exactly as before.
local steam_dir = tmp_cache .. "/steam"
package.preload["millennium"] = function()
	return {
		ready = function() end,
		steam_path = function() return steam_dir .. "/" end,
		config = {
			get = function(k) return stored[k] end,
			set = function(k, v) stored[k] = v end,
			delete = function(k) stored[k] = nil end,
		},
		assets = {
			read = function(path)
				local handle = io.open(root .. "/" .. path, "r")
				if not handle then return nil end
				local content = handle:read("*a")
				handle:close()
				return content
			end,
		},
	}
end
-- os.execute is captured below, so the stub binds the real one now and
-- creates directories for real.
local mkdir_execute = os.execute
package.preload["fs"] = function()
	return {
		create_directories = function(path)
			return mkdir_execute("mkdir -p '" .. path .. "'") ~= nil
		end,
	}
end

-- Enough JSON for the flat payloads the frontend sends: strings, booleans and
-- numbers. Anything else these messages do not use.
local function decode(text)
	-- The real json module errors on non-JSON; the permissive stub hid that.
	if not text:match("^%s*{") then error("not a JSON object") end
	local out = {}
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*"(.-)"') do
		out[key] = value:gsub('\\"', '"')
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(true)') do
		out[key] = true
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(false)') do
		out[key] = false
	end
	for key, value in text:gmatch('"([%w_]+)"%s*:%s*(%-?%d+%.?%d*)') do
		out[key] = tonumber(value)
	end
	return out
end
local function encode(value)
	local parts = {}
	for k, v in pairs(value) do
		local rendered = type(v) == "string" and ('"' .. v .. '"') or tostring(v)
		parts[#parts + 1] = '"' .. k .. '":' .. rendered
	end
	return "{" .. table.concat(parts, ",") .. "}"
end
package.preload["json"] = function()
	return { decode = decode, encode = encode }
end

local executed = {}
local real_execute = os.execute
os.execute = function(command)
	executed[#executed + 1] = command
	return true
end

local plugin = dofile(root .. "/backend/main.lua")

local failures = 0
local function check(what, ok, detail)
	if ok then
		print(("  ok   %s"):format(what))
	else
		failures = failures + 1
		print(("  FAIL %s%s"):format(what, detail and ("\n       " .. detail) or ""))
	end
end

-- on_load must not throw, and must find the helper.
local ok, err = pcall(plugin.on_load)
check("on_load runs", ok, err)

local sawHelper = false
for _, entry in ipairs(logged) do
	if entry[2]:find("helper: ") then sawHelper = true end
	if entry[1] == "error" then check("no errors at load", false, entry[2]) end
end
check("helper installed at load", sawHelper)

-- The materialized helper must be byte-identical to the packed asset (here:
-- the repo copy the assets.read stub serves).
local function slurp(path)
	local handle = io.open(path, "r")
	if not handle then return nil end
	local content = handle:read("*a")
	handle:close()
	return content
end
check("helper materialized verbatim",
	slurp(tmp_cache .. "/steam-native-notify/notify-action") == slurp(root .. "/tools/notify-action"))

-- A notification with no route: the download-complete shape.
executed = {}
ok, err = pcall(Notify, "Download Complete", "Aircar is ready", "https://steamloopback.host/assets/1073390/x.jpg?c=1", nil, nil)
check("Notify with no route runs", ok, err)
check("Notify spawned something", #executed == 1, tostring(#executed) .. " commands")
if executed[1] then
	check("spawns the helper through sh", executed[1]:sub(1, 3) == "sh ", executed[1])
	check("spawns the materialized helper", executed[1]:find("steam%-native%-notify/notify%-action") ~= nil, executed[1])
	check("passes the title", executed[1]:find("'Download Complete'", 1, true) ~= nil, executed[1])
	check("passes the image", executed[1]:find("steamloopback", 1, true) ~= nil, executed[1])
	check("backgrounded", executed[1]:sub(-1) == "&", executed[1])
end

-- A notification with a route: the friend-message shape.
executed = {}
ok = pcall(Notify, "NightFury", "hello", "", "steam://friends/message/76561198257837083", nil)
check("Notify with a route runs", ok)
if executed[1] then
	check("passes the route", executed[1]:find("steam://friends/message/", 1, true) ~= nil, executed[1])
end

-- The body crosses to the helper raw; markup escaping is the helper's job,
-- done next to the notify-send that renders it (asserted further down).
executed = {}
pcall(Notify, "Someone", "a < b & c", "", nil, nil)
if executed[1] then
	check("passes the body raw", executed[1]:find("'a < b & c'", 1, true) ~= nil, executed[1])
end

-- A shell metacharacter in the body must not escape its quoting.
executed = {}
pcall(Notify, "Someone", "; touch /tmp/pwned #", "", nil, nil)
if executed[1] then
	check("quotes shell metacharacters", executed[1]:find("'; touch /tmp/pwned #'", 1, true) ~= nil, executed[1])
end

-- Settings live per-key in Millennium's config store; the backend's only job
-- is the one-time move of the legacy one-document form, run at load. The
-- retired nativeToastInGame key inverts into notifyInGame; existing per-key
-- values always win over the document; the document is removed either way.
stored.settings = '{"hideSteamToast":true,"devFire":true,"nativeToastInGame":true}'
stored.devFire = nil
stored.notifyInGame = nil
ok = pcall(plugin.on_load)
check("migration runs at load", ok)
check("migration moves document keys per-key", stored.devFire == true, tostring(stored.devFire))
check("migration inverts nativeToastInGame", stored.notifyInGame == false, tostring(stored.notifyInGame))
check("migration removes the document", stored.settings == nil, tostring(stored.settings))

stored.settings = '{"devFire":false}'
pcall(plugin.on_load)
check("existing per-key value wins over the document", stored.devFire == true, tostring(stored.devFire))
check("losing document is removed too", stored.settings == nil, tostring(stored.settings))

stored.settings = "not json"
pcall(plugin.on_load)
check("garbage document is dropped", stored.settings == nil, tostring(stored.settings))

stored.settings = nil
stored.notifyOutsideGame = nil
pcall(plugin.on_load)
check("fresh install seeds no keys", stored.notifyOutsideGame == nil, tostring(stored.notifyOutsideGame))

-- Identity: shape only. The steamid comes from the machine's loginusers.vdf,
-- which this test does not fabricate; present it must be a steamid64, absent
-- the object is simply empty and the frontend routes without one.
local id_json
ok, id_json = pcall(Identity)
check("Identity runs", ok, id_json)
check("Identity returns JSON", type(id_json) == "string" and id_json:sub(1, 1) == "{", tostring(id_json))
if type(id_json) == "string" and id_json:find("steamid64") then
	check("Identity id is a steamid64", id_json:find('"7656119%d%d%d%d%d%d%d%d%d%d"') ~= nil, id_json)
end

-- With a loginusers.vdf under Millennium's steam_path, that file wins over
-- the hard-coded locations (steam_path answers with a trailing slash, as
-- Millennium's Linux build does). Two users, MostRecent on the second.
io.popen("mkdir -p '" .. steam_dir .. "/config'"):close()
local vdf = assert(io.open(steam_dir .. "/config/loginusers.vdf", "w"))
vdf:write([[
"users"
{
	"76561198000000001"
	{
		"AccountName"		"first"
		"MostRecent"		"0"
	}
	"76561198000000002"
	{
		"AccountName"		"second"
		"MostRecent"		"1"
	}
}
]])
vdf:close()
ok, id_json = pcall(Identity)
check("Identity reads loginusers.vdf under millennium.steam_path first",
	ok and id_json == '{"steamid64":"76561198000000002"}', tostring(id_json))
os.remove(steam_dir .. "/config/loginusers.vdf")

-- The same steam_path answer is published for the helper at load, trimmed
-- of its trailing slash, as one line in the runtime directory.
check("load publishes steam_path for the helper",
	slurp(tmp_cache .. "/steam-native-notify/steam-dir") == steam_dir .. "\n",
	tostring(slurp(tmp_cache .. "/steam-native-notify/steam-dir")))

-- With nothing under steam_path, the Linux guesses run native first
-- (~/.steam/steam, then ~/.local/share/Steam), then Steam's Flatpak per-app
-- directory as the host sees it. HOME moves to a throwaway directory so the
-- machine's real loginusers.vdf stays out of it.
local guess_home = tmp_cache .. "/home"
os.getenv = function(name)
	if name == "XDG_CACHE_HOME" then return tmp_cache end
	if name == "HOME" then return guess_home end
	return real_getenv(name)
end
local function write_loginusers(dir, id)
	io.popen("mkdir -p '" .. dir .. "/config'"):close()
	local f = assert(io.open(dir .. "/config/loginusers.vdf", "w"))
	f:write('"users"\n{\n\t"' .. id .. '"\n\t{\n\t\t"MostRecent"\t\t"1"\n\t}\n}\n')
	f:close()
end
write_loginusers(guess_home .. "/.var/app/com.valvesoftware.Steam/.steam/steam", "76561198000000011")
ok, id_json = pcall(Identity)
check("Identity falls back to the Flatpak per-app ~/.steam/steam",
	ok and id_json == '{"steamid64":"76561198000000011"}', tostring(id_json))
write_loginusers(guess_home .. "/.var/app/com.valvesoftware.Steam/.local/share/Steam", "76561198000000012")
ok, id_json = pcall(Identity)
check("Identity prefers the Flatpak per-app ~/.local/share/Steam",
	ok and id_json == '{"steamid64":"76561198000000012"}', tostring(id_json))
write_loginusers(guess_home .. "/.local/share/Steam", "76561198000000013")
ok, id_json = pcall(Identity)
check("Identity prefers a native ~/.local/share/Steam over the Flatpak ones",
	ok and id_json == '{"steamid64":"76561198000000013"}', tostring(id_json))
write_loginusers(guess_home .. "/.steam/steam", "76561198000000014")
ok, id_json = pcall(Identity)
check("Identity prefers a native ~/.steam/steam over everything but steam_path",
	ok and id_json == '{"steamid64":"76561198000000014"}', tostring(id_json))
os.getenv = function(name)
	if name == "XDG_CACHE_HOME" then return tmp_cache end
	return real_getenv(name)
end

-- TakeDevCommand: consume-once semantics against the runtime cache directory
-- (created by on_load above), the same place tools/fire writes.
local fire = assert(io.open(tmp_cache .. "/steam-native-notify/.dev-fire", "w"))
fire:write('{"call":"TestFriendOnline","args":[]}')
fire:close()
local taken
ok, taken = pcall(TakeDevCommand)
check("TakeDevCommand runs", ok, taken)
check("TakeDevCommand returns the command", type(taken) == "string" and taken:find("TestFriendOnline") ~= nil, tostring(taken))
ok, taken = pcall(TakeDevCommand)
check("TakeDevCommand consumes once", ok and taken == "", tostring(taken))

-- TakeClick: the click handoff, same consume-once contract. The file holds a
-- stamped payload (<epoch-seconds>|<payload>); the stamp is the bridge's
-- business, so TakeClick passes it through untouched.
local click = assert(io.open(tmp_cache .. "/steam-native-notify/.click", "w"))
click:write("1756500000|steam://openurl/https://store.steampowered.com/gifts/")
click:close()
ok, taken = pcall(TakeClick)
check("TakeClick passes the stamped payload through verbatim",
	ok and taken == "1756500000|steam://openurl/https://store.steampowered.com/gifts/", tostring(taken))
ok, taken = pcall(TakeClick)
check("TakeClick consumes once", ok and taken == "", tostring(taken))

-- Every argument absent must not throw; the title falls back to the app name.
executed = {}
ok = pcall(Notify)
check("survives absent arguments", ok)
if executed[1] then
	check("absent title falls back to the app name", executed[1]:find("'Steam'", 1, true) ~= nil, executed[1])
end

-- notify-action's click plan: every clickable payload rides the bridge, which
-- picks the surface by live focus inside Steam; only a notification with
-- neither route nor action token does nothing on click.
local function click_plan(route, action)
	local handle = io.popen(root .. "/tools/notify-action --click-plan '" .. route
		.. "' '" .. (action or "") .. "'")
	local plan = handle:read("*l")
	handle:close()
	return plan
end
check("click plan: chat route rides the bridge", click_plan("steam://friends/message/76561198000000000") == "overlay")
check("click plan: nav route rides the bridge", click_plan("steam://nav/games/details/570") == "overlay")
check("click plan: openurl route rides the bridge", click_plan("steam://openurl/https://steamcommunity.com/x") == "overlay")
check("click plan: settings route rides the bridge", click_plan("steam://settings/system") == "overlay")
check("click plan: action token rides the bridge", click_plan("", "media") == "overlay")
check("click plan: no route and no action does nothing", click_plan("") == "none")

-- notify-action's markup escaping: the daemon parses the body as markup, so
-- what the helper hands notify-send must have &, <, > entity-escaped.
local function escaped_body(text)
	local handle = io.popen(root .. "/tools/notify-action --escape-markup '" .. text .. "'")
	local out = handle:read("*a")
	handle:close()
	return out
end
check("escape: entities", escaped_body("a < b & c") == "a &lt; b &amp; c")
check("escape: ampersand first", escaped_body("&lt;") == "&amp;lt;")
check("escape: clean text untouched", escaped_body("hello there") == "hello there")

-- notify-action's icon resolution, offline paths only: anything that cannot be
-- mapped to an existing file must fall back to the "steam" theme icon.
local function resolved_icon(url)
	local handle = io.popen(root .. "/tools/notify-action --resolve-icon '" .. url .. "'")
	local icon = handle:read("*l")
	handle:close()
	return icon
end
check("resolve-icon: missing library-cache asset falls back",
	resolved_icon("https://steamloopback.host/assets/999999999/missing.jpg?c=1") == "steam")
check("resolve-icon: missing absolute path falls back",
	resolved_icon("/nonexistent/steam-native-notify/icon.png") == "steam")
check("resolve-icon: garbage falls back",
	resolved_icon("not a url at all") == "steam")

-- notify-action's library-cache lookup, per platform. HOME and the runtime
-- directory move to a throwaway tree: the guesses run native first, then the
-- Flatpak per-app directory, then the macOS data directory, and the steam-dir
-- file the backend publishes beats every guess while it holds a library
-- cache.
local lc_h = io.popen("mktemp -d")
local lc_home = lc_h:read("*l")
lc_h:close()
if lc_home and lc_home ~= "" then
	local art_url = "https://steamloopback.host/assets/1073390/library_600x900.jpg?c=7"
	local art_tail = "/appcache/librarycache/1073390/library_600x900.jpg"
	local function place_art(dir)
		io.popen("mkdir -p '" .. dir .. "/appcache/librarycache/1073390' && printf 'x' > '"
			.. dir .. art_tail .. "'"):close()
	end
	local function resolved_under_home()
		local h = io.popen("HOME='" .. lc_home .. "' XDG_CACHE_HOME='" .. lc_home .. "/cache' "
			.. root .. "/tools/notify-action --resolve-icon '" .. art_url .. "'")
		local out = h:read("*l")
		h:close()
		return out
	end
	local function publish_steam_dir(dir)
		io.popen("mkdir -p '" .. lc_home .. "/cache/steam-native-notify' && printf '%s\\n' '" .. dir
			.. "' > '" .. lc_home .. "/cache/steam-native-notify/steam-dir'"):close()
	end
	check("resolve-icon: no Steam directory anywhere falls back",
		resolved_under_home() == "steam", tostring(resolved_under_home()))
	local mac_steam = lc_home .. "/Library/Application Support/Steam"
	place_art(mac_steam)
	check("resolve-icon: macOS Application Support library cache",
		resolved_under_home() == mac_steam .. art_tail, tostring(resolved_under_home()))
	local flatpak_steam = lc_home .. "/.var/app/com.valvesoftware.Steam/.steam/steam"
	place_art(flatpak_steam)
	check("resolve-icon: Flatpak per-app library cache beats the macOS guess",
		resolved_under_home() == flatpak_steam .. art_tail, tostring(resolved_under_home()))
	local flatpak_data = lc_home .. "/.var/app/com.valvesoftware.Steam/.local/share/Steam"
	place_art(flatpak_data)
	check("resolve-icon: Flatpak per-app .local/share/Steam beats its .steam/steam",
		resolved_under_home() == flatpak_data .. art_tail, tostring(resolved_under_home()))
	local native_steam = lc_home .. "/.local/share/Steam"
	place_art(native_steam)
	check("resolve-icon: native library cache beats the Flatpak guesses",
		resolved_under_home() == native_steam .. art_tail, tostring(resolved_under_home()))
	local published_steam = lc_home .. "/elsewhere/Steam"
	place_art(published_steam)
	publish_steam_dir(published_steam)
	check("resolve-icon: the published steam-dir beats every guess",
		resolved_under_home() == published_steam .. art_tail, tostring(resolved_under_home()))
	publish_steam_dir(lc_home .. "/nowhere/Steam")
	check("resolve-icon: a published steam-dir without a library cache falls through",
		resolved_under_home() == native_steam .. art_tail, tostring(resolved_under_home()))
	io.popen("rm -rf '" .. lc_home .. "'"):close()
else
	print("  skip library-cache candidates (mktemp failed)")
end

-- Unsupported platforms are refused in plugin.log, never silently: uname is
-- shimmed to answer Darwin, and a shimmed notify-send records whether
-- delivery was attempted. Then, on a Linux PATH without notify-send at all
-- (only the shims the gate itself needs), the missing tool is named.
local gate_h = io.popen("mktemp -d")
local gate_dir = gate_h:read("*l")
gate_h:close()
if gate_dir and gate_dir ~= "" then
	local u = assert(io.open(gate_dir .. "/uname", "w"))
	u:write("#!/bin/sh\necho Darwin\n")
	u:close()
	local ns = assert(io.open(gate_dir .. "/notify-send", "w"))
	ns:write("#!/bin/sh\nprintf 'called' > " .. gate_dir .. "/sent\nexit 0\n")
	ns:close()
	io.popen("chmod +x '" .. gate_dir .. "/uname' '" .. gate_dir .. "/notify-send'"):close()
	io.popen("mkdir -p '" .. gate_dir .. "/steam-native-notify'"):close()
	local status = io.popen("XDG_CACHE_HOME='" .. gate_dir .. "' PATH='" .. gate_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action 'T' 'b' '' '' >/dev/null 2>&1; echo $?"):read("*l")
	local gate_log = slurp(gate_dir .. "/steam-native-notify/plugin.log") or "(no log)"
	check("macos helper: refused in plugin.log",
		gate_log:find("notify-action: unsupported platform: macos", 1, true) ~= nil, gate_log)
	check("macos helper: exits non-zero", status == "1", tostring(status))
	check("macos helper: never calls notify-send", slurp(gate_dir .. "/sent") == nil)

	-- resolve-icon stays usable there: the seams run before the gate.
	local seam = io.popen("XDG_CACHE_HOME='" .. gate_dir .. "' PATH='" .. gate_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action --resolve-icon 'not a url'"):read("*l")
	check("macos helper: the resolve-icon seam still answers", seam == "steam", tostring(seam))

	local bare = gate_dir .. "/bare"
	io.popen("mkdir -p '" .. bare .. "' && printf '#!/bin/sh\\necho Linux\\n' > '" .. bare
		.. "/uname' && chmod +x '" .. bare .. "/uname' && ln -s \"$(command -v date)\" '" .. bare .. "/date'"):close()
	io.popen("rm -f '" .. gate_dir .. "/steam-native-notify/plugin.log'"):close()
	status = io.popen("XDG_CACHE_HOME='" .. gate_dir .. "' PATH='" .. bare .. "' "
		.. root .. "/tools/notify-action 'T' 'b' '' '' >/dev/null 2>&1; echo $?"):read("*l")
	gate_log = slurp(gate_dir .. "/steam-native-notify/plugin.log") or "(no log)"
	check("helper without notify-send: refused in plugin.log",
		gate_log:find("notify-action: notify-send not found", 1, true) ~= nil, gate_log)
	check("helper without notify-send: exits non-zero", status == "1", tostring(status))
	io.popen("rm -rf '" .. gate_dir .. "'"):close()
else
	print("  skip platform gate (mktemp failed)")
end

-- Delivery retry: at login the helper can run before the session's daemon
-- owns the bus name, and notify-send fails fast. A PATH shim fails twice and
-- succeeds on the third call; the helper must retry through the failures and
-- deliver exactly once.
local shim_handle = io.popen("mktemp -d")
local shim_dir = shim_handle:read("*l")
shim_handle:close()
if shim_dir and shim_dir ~= "" then
	local shim = assert(io.open(shim_dir .. "/notify-send", "w"))
	shim:write(([[#!/bin/sh
n=$(cat %s/count 2>/dev/null || echo 0)
n=$((n + 1))
printf %%s "$n" > %s/count
[ "$n" -ge 3 ] || exit 1
exit 0
]]):format(shim_dir, shim_dir))
	shim:close()
	-- gdbus shimmed to FAIL: the daemon is absent, so retries must proceed.
	local gdbus = assert(io.open(shim_dir .. "/gdbus", "w"))
	gdbus:write("#!/bin/sh\nexit 1\n")
	gdbus:close()
	io.popen("chmod +x '" .. shim_dir .. "/notify-send' '" .. shim_dir .. "/gdbus'"):close()
	io.popen("NOTIFY_ACTION_RETRY_DELAY=0 PATH='" .. shim_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action 'Retry Test' 'body' '' ''; echo done"):read("*a")
	local count_handle = io.open(shim_dir .. "/count", "r")
	local count = count_handle and count_handle:read("*a") or "(no shim calls)"
	if count_handle then count_handle:close() end
	check("delivery retried through daemon absence", count == "3", tostring(count))

	-- With the daemon REACHABLE (gdbus succeeds), a notify-send failure is not
	-- absence and must NOT be retried: retrying could re-deliver a toast that
	-- failed after display.
	io.popen("rm -f '" .. shim_dir .. "/count'; printf '#!/bin/sh\\nexit 0\\n' > '"
		.. shim_dir .. "/gdbus'; chmod +x '" .. shim_dir .. "/gdbus'"):close()
	io.popen("NOTIFY_ACTION_RETRY_DELAY=0 PATH='" .. shim_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action 'Retry Test' 'body' '' ''; echo done"):read("*a")
	count_handle = io.open(shim_dir .. "/count", "r")
	count = count_handle and count_handle:read("*a") or "(no shim calls)"
	if count_handle then count_handle:close() end
	check("no retry while the daemon is reachable", count == "1", tostring(count))
	io.popen("rm -rf '" .. shim_dir .. "'"):close()
else
	print("  skip delivery retry (mktemp failed)")
end

-- Markup escaping is conditional on the daemon's advertised capabilities:
-- a plain-text daemon must receive the raw body, a markup daemon the escaped
-- one, and an unreachable daemon defaults to escaped. gdbus and notify-send
-- are PATH-shimmed; the body is notify-send's tenth argument.
local function delivered_body(gdbus_script)
	local h = io.popen("mktemp -d")
	local dir = h:read("*l")
	h:close()
	if not dir or dir == "" then return nil end
	local g = assert(io.open(dir .. "/gdbus", "w"))
	g:write("#!/bin/sh\n" .. gdbus_script .. "\n")
	g:close()
	local ns = assert(io.open(dir .. "/notify-send", "w"))
	ns:write(([[#!/bin/sh
for a; do last=$a; done
printf '%%s' "$last" > %s/body
exit 0
]]):format(dir))
	ns:close()
	io.popen("chmod +x '" .. dir .. "/gdbus' '" .. dir .. "/notify-send'"):close()
	io.popen("PATH='" .. dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action 'T' 'a < b & c' '' ''; echo done"):read("*a")
	local b = io.open(dir .. "/body", "r")
	local body = b and b:read("*a") or "(nothing delivered)"
	if b then b:close() end
	io.popen("rm -rf '" .. dir .. "'"):close()
	return body
end
check("caps: markup daemon gets the escaped body",
	delivered_body([[echo "(['actions', 'body', 'body-markup'],)"]]) == "a &lt; b &amp; c")
check("caps: plain-text daemon gets the raw body",
	delivered_body([[echo "(['actions', 'body'],)"]]) == "a < b & c")
check("caps: unreachable daemon defaults to escaped",
	delivered_body([[exit 1]]) == "a &lt; b &amp; c")

-- The icon download must not inherit Steam's loader environment: the runtime
-- pins a libcurl.so.4 the system curl refuses, so resolve_icon clears the
-- loader vars. curl is shimmed to fail whenever LD_LIBRARY_PATH is set.
local scrub_h = io.popen("mktemp -d")
local scrub_dir = scrub_h:read("*l")
scrub_h:close()
if scrub_dir and scrub_dir ~= "" then
	local cs = assert(io.open(scrub_dir .. "/curl", "w"))
	cs:write([[#!/bin/sh
[ -z "${LD_LIBRARY_PATH:-}" ] || exit 1
[ -z "${LD_PRELOAD:-}" ] || exit 1
out=""
while [ $# -gt 1 ]; do [ "$1" = "-o" ] && out=$2; shift; done
[ -n "$out" ] && printf 'x' > "$out"
exit 0
]])
	cs:close()
	io.popen("chmod +x '" .. scrub_dir .. "/curl'"):close()
	local rh = io.popen("LD_LIBRARY_PATH='" .. scrub_dir .. "' LD_PRELOAD='" .. scrub_dir
		.. "/evil.so' XDG_CACHE_HOME='" .. scrub_dir
		.. "' PATH='" .. scrub_dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action --resolve-icon 'https://example.invalid/a.jpg'")
	local resolved = rh and rh:read("*l") or "(nothing)"
	if rh then rh:close() end
	check("icon download scrubs the loader environment",
		resolved ~= nil and resolved:find("/steam-native-notify/icons/", 1, true) ~= nil,
		tostring(resolved))
	io.popen("rm -rf '" .. scrub_dir .. "'"):close()
else
	print("  skip loader-scrub (mktemp failed)")
end

-- Resolving an icon prunes cache files untouched for 30 days and leaves fresh
-- ones alone. curl is shimmed to succeed so the resolve itself completes.
local prune_h = io.popen("mktemp -d")
local prune_dir = prune_h:read("*l")
prune_h:close()
if prune_dir and prune_dir ~= "" then
	local pc = assert(io.open(prune_dir .. "/curl", "w"))
	pc:write([[#!/bin/sh
out=""
while [ $# -gt 1 ]; do [ "$1" = "-o" ] && out=$2; shift; done
[ -n "$out" ] && printf 'x' > "$out"
exit 0
]])
	pc:close()
	io.popen("chmod +x '" .. prune_dir .. "/curl'"):close()
	local prune_icons = prune_dir .. "/steam-native-notify/icons"
	io.popen("mkdir -p '" .. prune_icons .. "'"):close()
	io.popen("touch -d '40 days ago' '" .. prune_icons .. "/old.jpg'"):close()
	io.popen("touch '" .. prune_icons .. "/new.jpg'"):close()
	io.popen("XDG_CACHE_HOME='" .. prune_dir .. "' PATH='" .. prune_dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action --resolve-icon 'https://example.invalid/a.jpg'; echo done"):read("*a")
	local old_f = io.open(prune_icons .. "/old.jpg", "r")
	local new_f = io.open(prune_icons .. "/new.jpg", "r")
	check("stale cached icons are pruned, fresh ones survive",
		old_f == nil and new_f ~= nil)
	if old_f then old_f:close() end
	if new_f then new_f:close() end
	io.popen("rm -rf '" .. prune_dir .. "'"):close()
else
	print("  skip icon-prune (mktemp failed)")
end

-- A file-backed icon must travel as an image-path hint (a file:// reference),
-- with -i carrying only the themed fallback: a path through -i becomes
-- image-data pixels, which die with the popup and leave history rows
-- iconless. notify-send is shimmed to dump its arguments.
local iconargs_h = io.popen("mktemp -d")
local iconargs_dir = iconargs_h:read("*l")
iconargs_h:close()
if iconargs_dir and iconargs_dir ~= "" then
	io.popen("printf 'x' > '" .. iconargs_dir .. "/avatar.jpg'"):close()
	local ns = assert(io.open(iconargs_dir .. "/notify-send", "w"))
	ns:write(([[#!/bin/sh
printf '%%s\n' "$@" > %s/args
exit 0
]]):format(iconargs_dir))
	ns:close()
	-- gdbus shimmed to fail and the cache redirected: the block must never
	-- touch the live session bus or the developer's real cache directory.
	local ig = assert(io.open(iconargs_dir .. "/gdbus", "w"))
	ig:write("#!/bin/sh\nexit 1\n")
	ig:close()
	io.popen("chmod +x '" .. iconargs_dir .. "/notify-send' '" .. iconargs_dir .. "/gdbus'"):close()
	io.popen("XDG_CACHE_HOME='" .. iconargs_dir .. "' PATH='" .. iconargs_dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action 'T' 'b' '" .. iconargs_dir .. "/avatar.jpg' ''; echo done"):read("*a")
	local af = io.open(iconargs_dir .. "/args", "r")
	local sent_args = af and af:read("*a") or "(no args)"
	if af then af:close() end
	check("file icon rides the image-path hint",
		sent_args:find("string:image-path:file://" .. iconargs_dir .. "/avatar.jpg", 1, true) ~= nil,
		sent_args)
	check("file icon leaves -i as the themed fallback",
		sent_args:find("-i\nsteam\n", 1, true) ~= nil
			and sent_args:find("-i\n" .. iconargs_dir, 1, true) == nil,
		sent_args)
	check("delivery carries the desktop-entry hint",
		sent_args:find("string:desktop-entry:steam", 1, true) ~= nil, sent_args)

	-- Flatpak Steam exports com.valvesoftware.Steam.desktop instead: that is
	-- the hint when the per-app directory is the Steam found (host side), or
	-- when this runs inside the sandbox (FLATPAK_ID), whatever HOME holds.
	local flat_home = iconargs_dir .. "/flathome"
	io.popen("mkdir -p '" .. flat_home .. "/.var/app/com.valvesoftware.Steam/.local/share/Steam/appcache/librarycache'"):close()
	io.popen("HOME='" .. flat_home .. "' XDG_CACHE_HOME='" .. iconargs_dir .. "' PATH='" .. iconargs_dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action 'T' 'b' '' ''; echo done"):read("*a")
	af = io.open(iconargs_dir .. "/args", "r")
	sent_args = af and af:read("*a") or "(no args)"
	if af then af:close() end
	check("Flatpak Steam found on the host names its desktop entry",
		sent_args:find("string:desktop-entry:com.valvesoftware.Steam\n", 1, true) ~= nil, sent_args)
	io.popen("FLATPAK_ID=com.valvesoftware.Steam HOME='" .. iconargs_dir .. "/nohome' XDG_CACHE_HOME='" .. iconargs_dir
		.. "' PATH='" .. iconargs_dir .. "':\"$PATH\" " .. root
		.. "/tools/notify-action 'T' 'b' '' ''; echo done"):read("*a")
	af = io.open(iconargs_dir .. "/args", "r")
	sent_args = af and af:read("*a") or "(no args)"
	if af then af:close() end
	check("inside the Steam sandbox the desktop entry follows FLATPAK_ID",
		sent_args:find("string:desktop-entry:com.valvesoftware.Steam\n", 1, true) ~= nil, sent_args)
	io.popen("rm -rf '" .. iconargs_dir .. "'"):close()
else
	print("  skip icon-args (mktemp failed)")
end

-- A clicked route is written to the click file stamped with the write time
-- (<epoch-seconds>|<payload>), so the bridge can drop a click that outlived
-- its arm window. notify-send is shimmed to report the click.
local click_h = io.popen("mktemp -d")
local click_dir = click_h:read("*l")
click_h:close()
if click_dir and click_dir ~= "" then
	local ns = assert(io.open(click_dir .. "/notify-send", "w"))
	ns:write("#!/bin/sh\nprintf 'default'\nexit 0\n")
	ns:close()
	io.popen("chmod +x '" .. click_dir .. "/notify-send'"):close()
	io.popen("mkdir -p '" .. click_dir .. "/steam-native-notify'"):close()
	io.popen("XDG_CACHE_HOME='" .. click_dir .. "' PATH='" .. click_dir .. "':\"$PATH\" "
		.. root .. "/tools/notify-action 'T' 'b' '' 'steam://openurl/x' ''; echo done"):read("*a")
	local cf = io.open(click_dir .. "/steam-native-notify/.click", "r")
	local written = cf and cf:read("*a") or "(no click file)"
	if cf then cf:close() end
	check("clicked route is written stamped", written:match("^%d+|steam://openurl/x$") ~= nil, tostring(written))
	io.popen("rm -rf '" .. click_dir .. "'"):close()
else
	print("  skip stamped click (mktemp failed)")
end

-- ---------------------------------------------------------------------------
-- The Windows branch. main.lua reads the platform off package.config's first
-- character at load, so the module is loaded a second time under a Windows
-- configuration: the runtime directory moves under %LOCALAPPDATA%, no helper
-- is materialized, and Notify refuses in the log instead of spawning `sh`.
-- Backslashes are ordinary filename characters on Linux, so every joined
-- path is exercised for real inside tmp_cache (as entries whose names
-- contain backslashes). Globals from the second load replace the first's;
-- nothing below needs the POSIX ones.
-- ---------------------------------------------------------------------------
local posix_config = package.config
package.config = "\\\n;\n?\n!\n-\n"
local win_local = tmp_cache .. "/winlocal"
os.getenv = function(name)
	if name == "LOCALAPPDATA" then return win_local end
	if name == "XDG_CACHE_HOME" then return tmp_cache end
	return real_getenv(name)
end
io.popen("mkdir -p '" .. win_local .. "'"):close()
local win_runtime = win_local .. "\\steam-native-notify"

logged = {}
executed = {}
local win_plugin = dofile(root .. "/backend/main.lua")
ok, err = pcall(win_plugin.on_load)
check("windows: on_load runs", ok, err)

local win_platform, win_unsupported, win_helper = false, false, false
for _, entry in ipairs(logged) do
	if entry[2]:find("platform: windows", 1, true) then win_platform = true end
	if entry[1] == "error" and entry[2]:find("not implemented on windows", 1, true) then win_unsupported = true end
	if entry[2]:find("helper: ", 1, true) then win_helper = true end
end
check("windows: load names the platform", win_platform)
check("windows: load reports delivery unsupported as an error", win_unsupported)
check("windows: no helper is materialized", not win_helper)
check("windows: runtime directory lives under LOCALAPPDATA",
	slurp(win_runtime .. "\\plugin.log") ~= nil
		and slurp(win_runtime .. "\\plugin.log"):find("platform: windows runtime: " .. win_runtime, 1, true) ~= nil,
	tostring(slurp(win_runtime .. "\\plugin.log")))

-- Notify must not spawn anything, must say so, and must not throw.
local win_result
ok, win_result = pcall(Notify, "Download Complete", "Aircar is ready", "", "", "")
check("windows: Notify runs", ok, win_result)
check("windows: Notify spawns nothing", #executed == 0, tostring(#executed) .. " commands")
check("windows: Notify reports unsupported", win_result == "unsupported", tostring(win_result))
local win_dropped = false
for _, entry in ipairs(logged) do
	if entry[1] == "error" and entry[2]:find("unsupported platform", 1, true) then win_dropped = true end
end
check("windows: dropped notification is logged", win_dropped)

-- The click and dev-command handoffs join with the platform separator.
local win_click = assert(io.open(win_runtime .. "\\.click", "w"))
win_click:write("1756500000|replay:notificationtoasts_3_desktop")
win_click:close()
ok, taken = pcall(TakeClick)
check("windows: TakeClick reads the separator-joined path",
	ok and taken == "1756500000|replay:notificationtoasts_3_desktop", tostring(taken))
local win_fire = assert(io.open(win_runtime .. "\\.dev-fire", "w"))
win_fire:write('{"call":"TestFriendOnline","args":[]}')
win_fire:close()
ok, taken = pcall(TakeDevCommand)
check("windows: TakeDevCommand reads the separator-joined path",
	ok and taken:find("TestFriendOnline") ~= nil, tostring(taken))

-- Identity: only millennium.steam_path is consulted (no ~/.steam guesses),
-- joined with backslashes under the stub's trailing-slash answer.
local win_vdf = assert(io.open(steam_dir .. "\\config\\loginusers.vdf", "w"))
win_vdf:write('"users"\n{\n\t"76561198000000003"\n\t{\n\t\t"MostRecent"\t\t"1"\n\t}\n}\n')
