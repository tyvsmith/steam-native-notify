#!/usr/bin/env bash
# Fire a test notification through Steam's own toast pipeline.
#
# Writes a command file the plugin's debug poll consumes (within ~3s); the
# frontend calls the named method on Steam's NotificationStore, whose Test*
# functions synthesize a real notification. See docs/steam-routing.md,
# "Test harness", for what exists. Server-backed types (Wishlist, TradeOffer,
# Comment...) cannot be fired this way: their test path is disabled in the
# shipped client.
#
# Usage:
#   tools/fire TestDownloadComplete 1073390
#   tools/fire TestFriendOnline
#   tools/fire TestFriendMessage null '"Ready to play?"'
#   tools/fire TestAchievement 570
#
# Server-sourced (eSource=2) types, whose shipped test methods are stubbed, go
# through the real ingestion path instead (OnServerNotification):
#   tools/fire --wishlist [appid]              store-bound wishlist toast
#                                              (appid must be a known app;
#                                               defaults to 1073390, Aircar)
#   tools/fire --server <type> '<body-json>'   any type; see the body_data
#                                              fields in docs/steam-routing.md
#
# Arguments are JSON values (bare numbers and null pass through; quote strings).

set -euo pipefail

# The backend reads .dev-fire from the plugin's cache directory (the packed
# .star has no plugin directory at runtime); backend/main.lua computes the
# same path. Writing without the plugin installed would queue into a void
# while still printing "queued", hence the .star check.
RUNTIME_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/steam-native-notify"
STAR="$HOME/.local/share/millennium/plugins/me.tysmith.steam-native-notify.star"
if [[ ! -f $STAR ]]; then
  echo "not installed: $STAR does not exist" >&2
  echo "build first: bun run build (output_path=auto installs it)" >&2
  exit 1
fi
mkdir -p "$RUNTIME_DIR"

if [[ $# -lt 1 ]]; then
  sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 2
fi

if [[ $1 == --wishlist ]]; then
  appid="${2:-1073390}"
  printf '{"server":{"type":8,"body":{"appid":%s,"count":1}}}\n' "$appid" >"$RUNTIME_DIR/.dev-fire"
  echo "queued: server Wishlist appid=$appid  (needs the tools/fire toggle on in the plugin settings; picked up within ~3s)"
  exit 0
fi

# Overlay research probes (in-game click investigation; see devfire.ts):
#   tools/fire --overlay-info                     dump overlay browser PIDs
#   tools/fire --overlay-activate <appid> <url>   synthetic ActivateGameOverlayToWebPage
if [[ $1 == --overlay-info ]]; then
  printf '{"overlay":{"call":"info"}}\n' >"$RUNTIME_DIR/.dev-fire"
  echo "queued: overlay info  (result lands in the plugin log)"
  exit 0
fi

if [[ $1 == --overlay-activate ]]; then
  appid="${2:?--overlay-activate needs an appid}"
  url="${3:?--overlay-activate needs a url}"
  printf '{"overlay":{"call":"activate","appid":%s,"url":"%s"}}\n' "$appid" "$url" >"$RUNTIME_DIR/.dev-fire"
  echo "queued: overlay activate appid=$appid"
  exit 0
fi

if [[ $1 == --overlay-dialog ]]; then
  appid="${2:?--overlay-dialog needs an appid}"
  dialog="${3:?--overlay-dialog needs a dialog name (settings, requestplaytime, friends, ...)}"
  printf '{"overlay":{"call":"dialog","appid":%s,"url":"%s"}}\n' "$appid" "$dialog" >"$RUNTIME_DIR/.dev-fire"
  echo "queued: overlay dialog appid=$appid $dialog"
  exit 0
fi

if [[ $1 == --overlay-media ]]; then
  appid="${2:?--overlay-media needs an appid}"
  printf '{"overlay":{"call":"media","appid":%s}}\n' "$appid" >"$RUNTIME_DIR/.dev-fire"
  echo "queued: overlay media appid=$appid"
  exit 0
fi

# Click-replay experiment probes (docs/experiments/click-replay.md):
#   tools/fire --replay inspect          dump the stashed handler candidates
#   tools/fire --replay invoke [name]    invoke a stashed handler (latest if
#                                        no toast name is given)
if [[ $1 == --replay ]]; then
  call="${2:?--replay needs a call (inspect or invoke)}"
  name="${3:-}"
  if [[ -n $name ]]; then
    printf '{"replay":{"call":"%s","name":"%s"}}\n' "$call" "$name" >"$RUNTIME_DIR/.dev-fire"
  else
    printf '{"replay":{"call":"%s"}}\n' "$call" >"$RUNTIME_DIR/.dev-fire"
  fi
  echo "queued: replay $call ${name:-'(latest)'}  (result lands in the plugin log)"
  exit 0
fi

if [[ $1 == --server ]]; then
  type="${2:?--server needs a numeric ESteamNotificationType}"
  body="${3:-{\}}"
  printf '{"server":{"type":%s,"body":%s}}\n' "$type" "$body" >"$RUNTIME_DIR/.dev-fire"
  echo "queued: server type=$type body=$body  (needs the tools/fire toggle on in the plugin settings; picked up within ~3s)"
  exit 0
fi

call="$1"
shift

args="["
sep=""
for a in "$@"; do
  args+="$sep$a"
  sep=","
done
args+="]"

printf '{"call":"%s","args":%s}\n' "$call" "$args" >"$RUNTIME_DIR/.dev-fire"
echo "queued: $call $args  (needs the tools/fire toggle on in the plugin settings; picked up within ~3s)"
