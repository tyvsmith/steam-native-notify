#!/usr/bin/env bash
# Fire a test notification through Steam's own toast pipeline.
#
# Writes a command file the plugin's debug poll consumes (within ~3s); the
# frontend calls the named method on Steam's NotificationStore, whose Test*
# functions synthesize a real notification. See docs/steam-routing.md,
# "Test harness", for what exists. Server-backed types (Wishlist, TradeOffer,
# Comment...) cannot be fired this way: their test path is disabled in the
# shipped client.
#
# Usage:
#   tools/fire TestDownloadComplete 1073390
#   tools/fire TestFriendOnline
#   tools/fire TestFriendMessage null '"Ready to play?"'
#   tools/fire TestAchievement 570
#
# Server-sourced (eSource=2) types, whose shipped test methods are stubbed, go
# through the real ingestion path instead (OnServerNotification):
#   tools/fire --wishlist [appid]              store-bound wishlist toast
#                                              (appid must be a known app;
#                                               defaults to 1073390, Aircar)
#   tools/fire --server <type> '<body-json>'   any type; see the body_data
#                                              fields in docs/steam-routing.md
#
# Arguments are JSON values (bare numbers and null pass through; quote strings).

set -euo pipefail

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

if [[ $# -lt 1 ]]; then
  sed -n '2,23p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
  exit 2
fi

if [[ $1 == --wishlist ]]; then
  appid="${2:-1073390}"
  printf '{"server":{"type":8,"body":{"appid":%s,"count":1}}}\n' "$appid" >"$PLUGIN_DIR/.dev-fire"
  echo "queued: server Wishlist appid=$appid  (picked up within ~3s while Steam runs with the plugin in debug)"
  exit 0
fi

if [[ $1 == --server ]]; then
  type="${2:?--server needs a numeric ESteamNotificationType}"
  body="${3:-{\}}"
  printf '{"server":{"type":%s,"body":%s}}\n' "$type" "$body" >"$PLUGIN_DIR/.dev-fire"
  echo "queued: server type=$type body=$body  (picked up within ~3s while Steam runs with the plugin in debug)"
  exit 0
fi

call="$1"
shift

args="["
sep=""
for a in "$@"; do
  args+="$sep$a"
  sep=","
done
args+="]"

printf '{"call":"%s","args":%s}\n' "$call" "$args" >"$PLUGIN_DIR/.dev-fire"
echo "queued: $call $args  (picked up within ~3s while Steam runs with the plugin in debug)"
